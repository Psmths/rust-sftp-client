{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust SFTP Client",
  "version": "0.1.0",
  "identifier": "com.nerolinet.rust-sftp-client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rust SFTP Client",
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
