FROM rust:1-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    perl \
    pkg-config \
    libssl-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-dev \
    libwayland-dev \
    libx11-dev \
    libxcb1-dev \
    libxcb-render0-dev \
    libxcb-shape0-dev \
    libxcb-xfixes0-dev \
    libgl1-mesa-dev \
    libegl1-mesa-dev \
    libasound2-dev \
    ca-certificates \
    file \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["bash"]
