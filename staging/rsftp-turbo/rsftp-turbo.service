[Unit]
Description=rsftp-turbo UDP download accelerator for Rust SFTP Client
Documentation=https://github.com/Psmths/rust-sftp-client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rsftp-turbo serve
Restart=on-failure
RestartSec=2

# The daemon never opens files itself: `rsftp-turbo ticket` (run over SSH as
# the logged-in user) passes it already-open descriptors. It can therefore run
# as an unprivileged throw-away user with no access to anyone's files.
DynamicUser=yes
RuntimeDirectory=rsftp-turbo
RuntimeDirectoryMode=0755
LimitNOFILE=4096

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
